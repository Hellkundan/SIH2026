<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot Parent POM
        ─────────────────────
        This is the "parent" that tells Maven: use Spring Boot 3.3.x.
        It automatically manages compatible versions of ALL Spring libraries.
        You do NOT need to specify version numbers for Spring dependencies below.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- ─── Project Identity ─── -->
    <groupId>com.dixy</groupId>
    <artifactId>dixy-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>DIXY Backend</name>
    <description>DIXY – AI-Powered Bid Compliance Intelligence Platform · Member 6: Security, DevOps, QA</description>

    <!-- ─── Java Version ─── -->
    <properties>
        <java.version>17</java.version>
        <!-- JWT library version — we use jjwt 0.12.x (modern, Spring Boot 3 compatible) -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <!-- ─── Dependencies ─── -->
    <dependencies>

        <!-- ① Web: exposes REST endpoints via @RestController -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ② Security: activates Spring Security filter chain -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ③ JPA / Hibernate: maps Java classes to PostgreSQL tables -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ④ Validation: @NotBlank, @Email, @Size on DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ⑤ PostgreSQL JDBC driver: talks to the database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ⑥ JWT — jjwt API (defines the interfaces we use in code) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <!-- ⑥ JWT — jjwt implementation (the actual crypto code, loaded at runtime) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- ⑥ JWT — Jackson serializer for JWT claims -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ⑦ Swagger / OpenAPI: auto-generates /swagger-ui.html docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- ⑧ Lombok: reduces boilerplate with @Getter @Setter @Builder etc. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ⑨ H2 in-memory database: used ONLY for unit/integration tests -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ⑩ Spring Boot Test: JUnit 5, Mockito, MockMvc, TestRestTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ⑪ Spring Security Test: @WithMockUser, SecurityMockMvc -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ─── Build ─── -->
    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin: lets you run `mvn spring-boot:run` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Tell the plugin to exclude Lombok from the final JAR -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
